#!/usr/bin/env bash
# prelo-vigiar: pasta monitorada: todo livro que chega em ENTRADA é convertido
# para SAIDA. Usa o inotify (inotify-tools) se estiver instalado; senão, confere
# a pasta a cada poucos segundos. Pode virar um serviço do systemd do usuário.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/comum.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/comum.sh"

ajuda() {
  cat <<'EOF'
Uso: prelo-vigiar [opções] ENTRADA SAIDA [-- opções do prelo convert]

Converte automaticamente os livros que aparecem na pasta ENTRADA.

  -f, --formato FMT       epub, azw3, mobi, cbz, pdf ou txt (padrão: azw3)
  -p, --perfil ID         dispositivo (padrão: automático)
  -i, --intervalo SEG     espera entre verificações sem inotify (padrão: 5)
      --uma-vez           converte o que já está na pasta e sai
      --instalar-servico  instala e liga um serviço do systemd com estas opções
      --remover-servico   desliga e remove o serviço
  -h, --ajuda             mostra esta ajuda

Exemplo:
  prelo-vigiar -f azw3 -p kindle-pw5 --instalar-servico ~/Livros/Entrada ~/Livros/Kindle
EOF
}

SERVICO="prelo-vigiar.service"
UNIDADE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SERVICO"

formato=azw3 perfil=auto intervalo=5 uma_vez=0 instalar=0
pastas=() extras=()
while (($#)); do
  case "$1" in
    -f | --formato) formato="$(minusculas "${2:?falta o formato}")"; shift ;;
    -p | --perfil) perfil="${2:?falta o perfil}"; shift ;;
    -i | --intervalo) intervalo="${2:?falta o intervalo}"; shift ;;
    --uma-vez) uma_vez=1 ;;
    --instalar-servico) instalar=1 ;;
    --remover-servico)
      systemctl --user disable --now "$SERVICO" 2> /dev/null || true
      rm -f "$UNIDADE"
      systemctl --user daemon-reload
      ok "serviço removido"
      exit 0
      ;;
    -h | --ajuda | --help) ajuda; exit 0 ;;
    --) shift; extras=("$@"); break ;;
    -*) morrer "opção desconhecida: $1 (veja --ajuda)" ;;
    *) pastas+=("$1") ;;
  esac
  shift
done
((${#pastas[@]} == 2)) || { ajuda; exit 1; }
formato_valido "$formato" || morrer "formato inválido: $formato"
[[ "$intervalo" =~ ^[1-9][0-9]*$ ]] || morrer "--intervalo precisa ser um número de segundos"
entrada="$(readlink -m "${pastas[0]}")"
saida="$(readlink -m "${pastas[1]}")"
[[ "$entrada" != "$saida" ]] || morrer "ENTRADA e SAIDA precisam ser pastas diferentes"
mkdir -p "$entrada" "$saida"

# ---------------------------------------------------------------- serviço
aspas_systemd() {  # argumento como o systemd entende: entre aspas, % vira %%
  local s="${1//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "${s//%/%%}"
}
if ((instalar)); then
  comando=("$(readlink -f "${BASH_SOURCE[0]}")" -f "$formato" -p "$perfil" -i "$intervalo" "$entrada" "$saida")
  ((${#extras[@]})) && comando+=(-- "${extras[@]}")
  linha=""
  for a in "${comando[@]}"; do linha+="$(aspas_systemd "$a") "; done
  mkdir -p "$(dirname "$UNIDADE")"
  cat > "$UNIDADE" <<EOF
[Unit]
Description=Prelo: converte os livros que chegam em $entrada

[Service]
Type=simple
ExecStart=${linha% }
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICO"
  ok "serviço ligado: livros em $entrada viram ${formato^^} em $saida"
  info "acompanhar: journalctl --user -u $SERVICO -f"
  exit 0
fi

# ---------------------------------------------------------------- vigia
exec 9> "$saida/.prelo-vigiar.lock"
flock -n 9 || morrer "já existe um prelo-vigiar gravando em $saida"
[[ "$perfil" != auto ]] && extras=(--profile "$perfil" "${extras[@]}")
manifesto="$saida/.prelo-lote.tsv"
log="$(arquivo_de_log vigiar)"

estavel() {  # espera o arquivo parar de crescer (cópia ainda em andamento)
  local antes depois
  antes="$(stat -c %s -- "$1" 2> /dev/null || echo -1)"
  sleep 2
  depois="$(stat -c %s -- "$1" 2> /dev/null || echo -2)"
  [[ "$antes" == "$depois" && "$depois" -gt 0 ]]
}

declare -A vistos=()  # arquivo → "tamanho:data" já tratado (evita reler a pasta toda)

processar() {
  local f="$1" hash gerado assinatura
  e_livro "$f" || return 0
  [[ "$(extensao "$f")" == "$formato" ]] && return 0
  assinatura="$(stat -c '%s:%Y' -- "$f" 2> /dev/null)" || return 0
  [[ "${vistos[$f]:-}" == "$assinatura" ]] && return 0
  estavel "$f" || estavel "$f" || return 0
  vistos[$f]="$(stat -c '%s:%Y' -- "$f")"
  hash="$(hash_arquivo "$f")"
  manifesto_tem "$manifesto" "$hash" "$formato" "$perfil" && return 0
  info "convertendo ${f##*/}"
  if gerado="$(converter "$f" "$formato" "$saida" "$log" "${extras[@]}")" && [[ -f "$gerado" ]]; then
    manifesto_anota "$manifesto" "$hash" "$formato" "$perfil" "$gerado"
    ok "${f##*/} → ${gerado##*/}"
    notificar "Prelo: livro convertido" "${gerado##*/}"
  else
    erro "${f##*/} (detalhes em $log)"
    notificar "Prelo: falha na conversão" "${f##*/}"
  fi
}

varrer() {
  local f
  while IFS= read -r -d '' f; do processar "$f"; done \
    < <(find "$entrada" -mindepth 1 -maxdepth 1 -type f ! -name '.*' -print0 | sort -z)
}

titulo "Vigiando $entrada → $saida (${formato^^})"
varrer
((uma_vez)) && exit 0

if command -v inotifywait > /dev/null; then
  info "usando inotify"
  inotifywait -m -q -e close_write -e moved_to --format '%w%f' "$entrada" | while IFS= read -r f; do
    processar "$f"
  done
else
  info "inotify-tools não instalado: verificando a cada ${intervalo}s"
  while sleep "$intervalo"; do varrer; done
fi
